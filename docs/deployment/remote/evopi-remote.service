[Unit]
Description=EvoPi Remote Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/evopi remote serve default --proxy --bind 127.0.0.1 --port 8765 --allowed-host agent.example.com --trusted-proxy 127.0.0.0/8
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/.evopi

[Install]
WantedBy=default.target
